// Supernatural Ingredient Intelligence — Phase 1 schema.
//
// Design rules enforced here and in src/lib:
//  * Facts are never overwritten: a correction creates a new row and sets supersededAt/supersededById on the old one.
//  * Every fact-like row carries sourceId + entryMode + reviewStatus (provenance).
//  * Supplier recommendations, literature-tested levels, regulatory maxima, internal ranges and observed commercial use
//    are separate ConcentrationRecord types and are never merged.
//  * Private records (formulas, raw-material documents, research candidates) carry ownerOrgId + visibility.
//  * The knowledge graph is stored as typed, provenance-bearing edges (GraphEdge); see src/lib/graph.ts for the
//    abstraction layer that would let a graph database be added later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

