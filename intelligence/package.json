{
  "name": "supernatural-ingredient-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Supernatural Ingredient Intelligence — private ingredient, formulation, evidence and outcome-intelligence research platform.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx seed/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx seed/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "tsx tests/e2e/smoke.ts",
    "eval:search": "tsx scripts/search-eval.ts",
    "apikey:create": "tsx scripts/create-api-key.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "mathjs": "^15.2.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
