# --- Database (PostgreSQL 15+; extensions pg_trgm + unaccent required, pgvector optional for Phase 4)
DATABASE_URL="postgresql://sii:sii_dev@localhost:5432/sii_dev?schema=public"

# --- Security
# 32+ random bytes, base64. Signs file-download URLs and encrypts TOTP secrets at rest (rotating it requires users
# to re-enrol MFA). Generate with: openssl rand -base64 48. NEVER commit a real value.
APP_SECRET="change-me-generate-with-openssl-rand-base64-48"
# required | optional — MFA enforcement for privileged roles. Use "required" in staging/production.
MFA_ENFORCEMENT="required"
SESSION_TTL_HOURS="12"
APP_ENV="development"   # development | test | staging | production

# --- Storage (local disk adapter for dev; swap for Supabase/S3 adapter in production)
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="20"
# Optional ClamAV daemon for malware scanning of uploads (host:port). Without it, uploads stay "not scanned" and are admin-only.
CLAMD_HOST=""

# --- Seed
SEED_ADMIN_EMAIL="admin@example.test"
# Leave empty to have the seed generate a random password and print it once.
SEED_ADMIN_PASSWORD=""
# Seed demo users for every role (development/test only; refused when APP_ENV=production)
SEED_DEMO_USERS="true"
# Password for demo users (development/test only)
SEED_DEMO_PASSWORD="DemoUser!2026-local"

# --- Tests
# Integration tests TRUNCATE and reseed this database. It must be a dedicated test database.
TEST_DATABASE_URL="postgresql://sii:sii_dev@localhost:5432/sii_test?schema=public"
# Browser smoke test (npm run test:e2e) against a running server
E2E_BASE_URL="http://localhost:3100"

# --- External connectors (Phase 2). Not required for Phase 1.
NCBI_API_KEY=""
PATENTSVIEW_API_KEY=""
# --- AI research assistant. Optional. Without a key the assistant returns retrieved records with no AI summary.
# With a key, answers must cite retrieved records; uncited statements are dropped. Counts against the plan's AI limit.
ANTHROPIC_API_KEY=""

# --- Self-service signup (/signup). Off unless "true". Creates a trial organization with one Brand partner user.
ALLOW_SELF_SIGNUP="false"
