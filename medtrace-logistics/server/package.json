{
  "name": "medtrace-logistics-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.js",
    "start": "node --env-file=.env src/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node --env-file=.env node_modules/.bin/prisma migrate dev",
    "prisma:deploy": "node --env-file=.env node_modules/.bin/prisma migrate deploy",
    "prisma:seed": "node --env-file=.env prisma/seed.js",
    "prisma:studio": "node --env-file=.env node_modules/.bin/prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
