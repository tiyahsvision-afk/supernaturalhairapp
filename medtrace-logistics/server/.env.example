# Copy to .env and fill in for your environment. The server refuses to start
# without DATABASE_URL and JWT_SECRET — see src/env.js.

# PostgreSQL connection string. `docker compose up -d` in the repo root
# starts a local Postgres matching this default.
DATABASE_URL="postgresql://medtrace:medtrace_dev_password@localhost:5432/medtrace"

# Secret used to sign session JWTs. Generate a real one for anything beyond
# local dev, e.g.: openssl rand -base64 48
JWT_SECRET="medtrace-dev-secret-change-me"

PORT=4000
